# Database
DATABASE_URL=postgresql://meetedge:meetedge_dev@localhost:5432/meetedge

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# App
DEBUG=false
APP_NAME=MeetEdge

# Google Calendar (optional; run scripts/google_auth.py first)
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKEN_PATH=token.json

# JWT (optional; omit to auto-generate dev keys)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (optional; for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@meetedge.local

# Slack (optional)
SLACK_BOT_TOKEN=

# Gmail / Pub/Sub (see GMAIL_SETUP.md)
GMAIL_PUBSUB_TOPIC=
GMAIL_WEBHOOK_SECRET=
GOOGLE_BOT_EMAIL=
GOOGLE_BOT_PASSWORD=

# Audio for bot recording (optional; e.g. "BlackHole 2ch" on macOS)
AUDIO_DEVICE=

SECRET_KEY=change-me-in-production-min-32-chars
